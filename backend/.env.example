# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cogniuser:cognipass@localhost:5432/cogniload

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── ML Model ──────────────────────────────────────────────────────────────────
MODEL_PATH=ml/saved_models/model.joblib
SCALER_PATH=ml/saved_models/scaler.joblib

# ── App ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Phase 2: Refresh tokens ---
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Phase 2: WebSocket ---
WS_ENABLED=false

# --- Phase 2: Model metadata ---
MODEL_VERSION=0.1.0-rulebased
MODEL_TRAINED_AT=
MODEL_ACCURACY=

# --- Phase 2: Logging ---
LOG_LEVEL=INFO
LOG_DIR=
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# --- Phase 2: Request handling ---
MAX_BODY_SIZE=1048576
